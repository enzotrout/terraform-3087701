# Terraform local caches and state
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Local, potentially sensitive input values
*.tfvars
*.tfvars.json
.env
.env.*

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Intentionally track .terraform.lock.hcl if generated.
